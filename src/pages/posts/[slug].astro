---
import { getCollection, getEntry, render } from "astro:content";

// 静态站点下的动态路由：告诉 Astro 需要为哪些 slug 生成页面
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const post = await getEntry("posts", slug);

if (!post) {
  return Astro.notFound();
}

const { Content } = await render(post);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.data.title}</title>
  </head>
  <body>
    <main
      style="max-width: 720px; margin: 48px auto; padding: 0 16px; font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;"
    >
      <nav style="margin-bottom: 24px;">
        <a href="/" style="color: #2563eb; text-decoration: none;"
          >← 返回文章列表</a
        >
      </nav>

      <article>
        <header style="margin-bottom: 16px;">
          <h1 style="margin: 0 0 8px;">{post.data.title}</h1>
          <p style="margin: 0; color: #666;">{post.data.date}</p>

          {
            post.data.tags?.length ? (
              <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px;">
                {post.data.tags.map((tag) => (
                  <span style="background: #f3f4f6; border: 1px solid #e5e7eb; color: #374151; padding: 4px 10px; border-radius: 999px; font-size: 12px;">
                    {tag}
                  </span>
                ))}
              </div>
            ) : null
          }
        </header>

        {
          post.data.description ? (
            <p style="margin: 0 0 24px; color: #555;">
              {post.data.description}
            </p>
          ) : null
        }

        <section>
          <Content />
        </section>
      </article>
    </main>
  </body>
</html>
